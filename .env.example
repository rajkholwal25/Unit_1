FLASK_APP=manage.py
FLASK_ENV=development
SECRET_KEY=change-me
DATABASE_URL=postgresql://user:password@localhost:5432/bomdb

# SAP B1 Service Layer
SAP_SERVICE_LAYER_URL=https://your-sap-host:50000/b1s/v1
SAP_COMPANY_DB=YOUR_COMPANY_DB
SAP_USERNAME=manager
SAP_PASSWORD=your_password
SAP_OVERRIDE_POSTING_DATE=2025-01-01
SAP_RETRY=3
SAP_SSL_VERIFY=false

# Item Master
SAP_FG_ITEMS_GROUP=100
SAP_COMPONENT_ITEMS_GROUP=107

# UoM manual (-1): KGS inventory/sales/purchase; packaging UoM name
SAP_UOM_CODE=KGS
SAP_UOM_GROUP_ENTRY=-1
SAP_UOM_KGS_ENTRY=1
SAP_PACK_UOM_CODE=Role

# Set INVERT_UI=true if SAP General tab shows opposite labels (common on some B1 builds)
SAP_MATERIAL_TYPE_INVERT_UI=true
SAP_MATERIAL_TYPE_FG=mt_RawMaterial
SAP_MATERIAL_TYPE_COMPONENT=mt_FinishedGoods

SAP_ITEM_TAX_RATE=18
SAP_GST_TAX_CATEGORY=gtc_Regular
SAP_PRICING_UNIT=-1
